---
/*
 * Sun/moon drawn in-house: rounded joins, soft geometry, small accents —
 * HugeIcons-inspired, deliberately not the ubiquitous Lucide look.
 */
---

<button class="theme-toggle" type="button" aria-label="Switch to dark theme" title="Switch theme" data-theme-toggle>
  <svg class="theme-icon sun-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="4.4" />
    <path d="M12 3.2v1.2M12 19.6v1.2M3.2 12h1.2M19.6 12h1.2" />
    <path d="M5.9 5.9c.5.4.8.7 1.1 1.1M17 17c.5.4.8.7 1.1 1.1M18.1 5.9c-.5.4-.8.7-1.1 1.1M7 17c-.5.4-.8.7-1.1 1.1" />
  </svg>
  <svg class="theme-icon moon-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M20.3 14.6a8.9 8.9 0 0 1-8.5 5.9A8.7 8.7 0 0 1 3.4 12 8.8 8.8 0 0 1 9.8 3.6c.5-.14.9.33.7.8a7.3 7.3 0 0 0 9 9.5c.47-.16.94.24.8.7Z" />
    <path d="M16.5 4.5c.1 1.1.9 1.9 2 2-1.1.1-1.9.9-2 2-.1-1.1-.9-1.9-2-2 1.1-.1 1.9-.9 2-2Z" />
  </svg>
</button>

<script>
  const toggles = document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]");

  const getTheme = () =>
    document.documentElement.dataset.theme === "dark" ? "dark" : "light";

  const syncButtons = () => {
    const isDark = getTheme() === "dark";
    toggles.forEach((toggle) => {
      toggle.setAttribute("aria-label", isDark ? "Switch to light theme" : "Switch to dark theme");
      toggle.setAttribute("title", isDark ? "Switch to light theme" : "Switch to dark theme");
    });
  };

  toggles.forEach((toggle) => {
    toggle.addEventListener("click", () => {
      const nextTheme = getTheme() === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = nextTheme;
      localStorage.setItem("theme", nextTheme);
      syncButtons();
    });
  });

  syncButtons();
</script>
