---
interface Props {
  icon: string;
  label: string;
  href: string;
  color: string;
}

const { icon, label, href, color } = Astro.props;

const icons = import.meta.glob<string>("../icons/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});
const svg = icons[`../icons/${icon}.svg`];
---

<a class={`link link-${icon}`} href={href} target="_blank" rel="me noopener noreferrer" style={`--brand: ${color}`}>
  {svg && <span class="link-icon" set:html={svg} />}
  <span class="link-label">{label}</span>
  <svg class="link-arrow" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M4.5 11.5 11.5 4.5" />
    <path d="M6 4.5h5.5V10" />
  </svg>
</a>
