---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import LinkButton from "../components/LinkButton.astro";
import Scene from "../components/Scene.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { site, links } from "../data/site";
import avatar from "../assets/benji.webp";

const year = new Date().getFullYear();
---

<BaseLayout>
  <ThemeToggle />
  <Scene />
  <div class="scroll-track">
    <div class="stage">
      <main>
    <article class="card">
      <header>
        <div class="avatar-frame">
          <span class="avatar-clip">
            <Image class="avatar" src={avatar} alt={site.name} width={216} height={216} />
          </span>
        </div>
        <h1>{site.name}</h1>
        <p class="eyebrow">{site.headline}</p>
      </header>
      <nav class="links" aria-label="Profiles">
        {links.map((link) => <LinkButton {...link} />)}
      </nav>
    </article>
      </main>
      <footer>
        <p>&copy; {year} {site.name}</p>
        <p class="attribution">
          Built with <a href="https://appautomaton.github.io" target="_blank" rel="noopener noreferrer">AppAutomaton</a> by <a href="https://www.appcubic.com" target="_blank" rel="noopener noreferrer">AppCubic</a>
        </p>
      </footer>
    </div>
  </div>
  <div class="scroll-hint" aria-hidden="true">
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="m4 5.5 4 4 4-4" />
    </svg>
  </div>
</BaseLayout>
